# EcoWatch Comprehensive .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
venv/
.venv/
env/

# Node & Frontend Build
node_modules/
dist/
dist-ssr/
build/
.vite/
.parcel-cache/
.turbo/
coverage/

# Environment Configurations (keep .env.example only)
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
pip-log.txt

# OS & Editor Metadata
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.vscode/
.idea/

# Runtime Uploads & Database
backend/uploads/*
!backend/uploads/.gitkeep
*.bson
dbpath/
mongod.lock

# Verification, Local DevTools & Private Files
.devtools/
.agent/
.antigravity/
brain/
scratch/
tmp/
*.tmp
*.bak
*.orig
ponytail*
docs/screens/
*.png
!frontend/public/*.png
*.jpg
*.jpeg
